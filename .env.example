# Copy to .env for local development (runtime reads via pydantic-settings)
DATABASE_URL=postgresql+psycopg://aicery:aicery@localhost:5433/aicery
API_VERSION=0.0.1
API_KEY=dev
USE_MOCK_PROVIDER=true
WORKSPACE_ROOT=.
ALLOWED_HTTP_HOSTS=api.github.com,httpbin.org
MOCK_STREAM_CHUNKS=8
# CHAOS_TOOL_FAIL_RATE=0.3
NATS_URL=nats://localhost:4223
NATS_ENABLED=true

# Real provider (local only — never commit .env)
# USE_MOCK_PROVIDER=false
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.5-flash
REDIS_URL=redis://localhost:6380/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BACKEND=redis
PROVIDER_FAILOVER_ENABLED=true
